          },
          "description": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 4000,
            "description": "More on what it shows; null clears it."
          },
          "repo": {
            "type": "string",
            "nullable": true,
            "pattern": "^[\\w.-]+\\/[\\w.-]+$",
            "description": "The repository it is for, as `owner/name`; null clears it.",
            "example": "dakotacolorado/peek"
          },
          "pr": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
