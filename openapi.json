          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "More on what it shows, or what to look for."
          },
          "repo": {
            "type": "string",
            "pattern": "^[\\w.-]+\\/[\\w.-]+$",
