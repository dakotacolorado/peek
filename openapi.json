          },
          "sha256": {
            "type": "string",
            "nullable": true,
            "description": "Its SHA-256, in hex; null for a path asset not yet adopted."
          },
          "path": {
            "type": "string",
            "nullable": true,
            "description": "The file a not yet adopted asset is still served from; null once peek holds its bytes."
          },
          "title": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 200,
            "description": "What it shows, in a few words.",
            "example": "Login flow on iPhone"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 4000,
            "description": "More on what it shows, or what to look for."
          },
          "repo": {
            "type": "string",
            "nullable": true,
            "pattern": "^[\\w.-]+\\/[\\w.-]+$",
            "description": "The GitHub repository it is for, as `owner/name`.",
            "example": "dakotacolorado/peek"
          },
          "pr": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "description": "The pull request it is for, in `repo`.",
            "example": 12
          },
          "task": {
            "type": "string",
            "nullable": true,
            "pattern": "^[\\w-]{1,64}$",
            "description": "The waypoint task it is for, by its short id.",
            "example": "75d018b6"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^,\\u0000-\\u001f\\u007f]+$",
              "description": "A tag: any text without a comma."
            },
            "maxItems": 20,
            "description": "Tags, at most 20.",
            "example": [
              "before",
              "mobile"
            ]
          },
          "createdBy": {
            "type": "string",
            "description": "Who uploaded it: the uploader's `x-actor` header, else its token's name."
          },
          "createdAt": {
            "type": "string",
            "description": "Uploaded at (ISO 8601)."
          },
          "link": {
            "type": "string",
            "description": "Its page, which shows or plays it in the browser: the link to give the person."
          },
          "taskLink": {
            "type": "string",
            "nullable": true,
            "description": "Its task's page, when peek is given a task URL (`PEEK_TASK_URL`) and the asset a `task`; else null."
          },
          "fileUrl": {
            "type": "string",
            "description": "Its bytes, served with range support. A browser reaches it once signed in (`CreateSession`); anything else with a bearer token."
          }
        },
        "required": [
          "id",
          "name",
          "contentType",
          "size",
          "sha256",
          "path",
          "title",
          "description",
          "repo",
          "pr",
          "task",
          "tags",
          "createdBy",
          "createdAt",
          "link",
          "taskLink",
          "fileUrl"
        ],
        "description": "A file peek keeps, and what it is of."
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ValidationException",
              "UnauthorizedException",
              "AccessDeniedException",
              "ResourceNotFoundException",
              "ConflictException",
              "RangeNotSatisfiableException",
              "InternalServerException"
            ],
            "description": "Exception name."
          },
          "message": {
            "type": "string",
            "description": "What went wrong."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "description": "Every error's body."
      },
