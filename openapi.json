          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+$",
            "description": "The file's name, with its extension: no path.",
            "example": "login-flow.mp4"
          },
          "contentType": {
            "type": "string",
            "maxLength": 200,
            "description": "Its media type: the upload's `Content-Type`, or, when that says nothing (`application/octet-stream`), the name's extension's."
          },
          "size": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
