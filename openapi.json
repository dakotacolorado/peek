    "/f/{id}/{name}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "tags": [
          "Files"
        ],
        "operationId": "GetFile",
        "summary": "Get a file",
        "description": "An asset's bytes, as its `fileUrl` gives them, with its media type, `Accept-Ranges: bytes` and an `ETag` of its SHA-256. A `Range` of one span (`bytes=0-1023`, `bytes=1024-`, `bytes=-1024`) answers 206 with just those bytes, so a browser plays and seeks a video. `<img>`, `<video>` and `<audio>` load it once the browser is signed in (`CreateSession`).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[\\w-]{12}$",
              "description": "The asset's id: 12 URL-safe characters.",
              "example": "q3Xv9LmT0bZk"
            },
            "required": true,
            "description": "The asset's id: 12 URL-safe characters.",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+$",
              "description": "The asset's name, URL-encoded.",
              "example": "login-flow.mp4"
            },
            "required": true,
            "description": "The asset's name, URL-encoded.",
            "name": "name",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Any non-empty value, such as `1`, answers with `Content-Disposition: attachment` so a browser saves the file under its name instead of showing it."
            },
            "required": false,
            "description": "Any non-empty value, such as `1`, answers with `Content-Disposition: attachment` so a browser saves the file under its name instead of showing it.",
            "name": "download",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "One span of bytes, such as `bytes=0-1023`."
            },
            "required": false,
            "description": "One span of bytes, such as `bytes=0-1023`.",
            "name": "range",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "The whole file.",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "The span asked for, which `Content-Range` names.",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "UnauthorizedException: No bearer token or session, or it is wrong, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "ResourceNotFoundException: No asset has that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "416": {
            "description": "RangeNotSatisfiableException: The range starts past the end of the file.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
